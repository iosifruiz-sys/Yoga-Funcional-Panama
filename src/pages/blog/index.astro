---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/blog.css';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const formatDate = (date: Date) => new Intl.DateTimeFormat('es-PA', { dateStyle: 'long' }).format(date);
const slugFor = (id: string) => id.replace(/\.md$/, '');
---

<BaseLayout title="Blog | Yoga Funcional Panamá" description="Artículos sobre Yoga Funcional, fuerza, movilidad, respiración, atención, recuperación y meditación.">
  <Header />
  <main id="contenido" class="blog-main">
    <header class="blog-index-header">
      <h1>Blog</h1>
      <p>Artículos sobre Yoga Funcional y práctica.</p>
    </header>

    {posts.length > 0 ? (
      <ol class="blog-list">
        {posts.map((post) => {
          const slug = slugFor(post.id);
          return (
            <li>
              <article>
                {post.data.cover && <Image src={post.data.cover.image} alt={post.data.cover.alt} />}
                <header>
                  {post.data.category && <p>{post.data.category}</p>}
                  <h2><a href={`${base}blog/${slug}/`}>{post.data.title}</a></h2>
                  <p>{post.data.description}</p>
                  <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                </header>
              </article>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="blog-empty">Todavía no hay artículos publicados.</p>
    )}
  </main>
  <Footer />
</BaseLayout>
