---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/blog.css';

const base = import.meta.env.BASE_URL;
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const formatDate = (date: Date) => [date.getUTCDate(), date.getUTCMonth() + 1, date.getUTCFullYear()]
  .map((part) => String(part).padStart(2, '0'))
  .join('.');
const slugFor = (id: string) => id.replace(/\.md$/, '');
---

<BaseLayout title="Blog | Yoga Funcional Panamá" description="Artículos sobre Yoga Funcional, fuerza, movilidad, respiración, atención, recuperación y meditación.">
  <Header />
  <main id="contenido" class="blog-main">
    <header class="blog-index-header">
      <p class="blog-section-marker">07 / BLOG</p>
      <h1>BLOG</h1>
      <p class="blog-taxonomy">YOGA · MOVIMIENTO · MEDITACIÓN · CUERPO · ATENCIÓN</p>
    </header>

    {posts.length > 0 ? (
      <ol class="blog-list">
        {posts.map((post, index) => {
          const slug = slugFor(post.id);
          const href = `${base}blog/${slug}/`;
          return (
            <li>
              <article class:list={['blog-list-entry', { 'blog-list-entry--no-cover': !post.data.cover }]}>
                {post.data.cover && (
                  <a class="blog-list-image" href={href} aria-label={`Leer artículo: ${post.data.title}`}>
                    <Image src={post.data.cover.image} alt={post.data.cover.alt} widths={[640, 960, 1280]} sizes="(min-width: 62rem) 55vw, 100vw" />
                  </a>
                )}
                <div class="blog-list-content">
                  <p class="blog-list-number">{String(index + 1).padStart(2, '0')}</p>
                  <p class="blog-list-meta">
                    {post.data.category ?? 'Blog'} <span aria-hidden="true">·</span>{' '}
                    <time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time>
                  </p>
                  <h2><a href={href}>{post.data.title}</a></h2>
                  <p class="blog-list-description">{post.data.description}</p>
                  <a class="blog-list-cta" href={href} aria-label={`Leer artículo: ${post.data.title}`}>LEER ARTÍCULO <span aria-hidden="true">→</span></a>
                </div>
              </article>
            </li>
          );
        })}
      </ol>
    ) : (
      <p class="blog-empty">Todavía no hay artículos publicados.</p>
    )}
  </main>
  <Footer />
</BaseLayout>
