---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedPosts, slugForPost } from '../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  slug: string;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: slugForPost(post) },
    props: {
      post,
      slug: slugForPost(post),
      previousPost: posts[index + 1],
      nextPost: posts[index - 1],
    },
  }));
};

const { post, slug, previousPost, nextPost } = Astro.props;
const { Content } = await render(post);
---

<ArticleLayout post={post} slug={slug} previousPost={previousPost} nextPost={nextPost}>
  <Content />
</ArticleLayout>
