---
import type { GetStaticPaths } from 'astro';
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import ArticleLayout from '../../../layouts/ArticleLayout.astro';
import { findTranslation, getPublishedPosts, slugForPost } from '../../../lib/blog';

interface Props {
  post: CollectionEntry<'blog'>;
  slug: string;
  previousPost?: CollectionEntry<'blog'>;
  nextPost?: CollectionEntry<'blog'>;
}

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getPublishedPosts('ru');
  return posts.map((post, index) => ({
    params: { slug: slugForPost(post) },
    props: {
      post,
      slug: slugForPost(post),
      previousPost: posts[index + 1],
      nextPost: posts[index - 1],
    },
  }));
};

const { post, slug, previousPost, nextPost } = Astro.props;
const translation = await findTranslation(post, 'es');
const { Content } = await render(post);
---

<ArticleLayout post={post} slug={slug} locale="ru" previousPost={previousPost} nextPost={nextPost} translationSlug={translation ? slugForPost(translation) : undefined}>
  <Content />
</ArticleLayout>
