---
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/blog.css';

interface Props {
  post: CollectionEntry<'blog'>;
  slug: string;
}

const { post, slug } = Astro.props;
const { data } = post;
const base = import.meta.env.BASE_URL;
const canonical = new URL(`${base}blog/${slug}/`, Astro.site);
const personId = `${new URL(base, Astro.site).href}#person`;
const socialImage = data.socialImage ? await getImage({ src: data.socialImage }) : undefined;
const socialImageUrl = socialImage ? new URL(socialImage.src, Astro.site) : undefined;
const articleStructuredData = {
  '@type': 'BlogPosting',
  '@id': `${canonical.href}#article`,
  headline: data.title,
  description: data.description,
  datePublished: data.publishDate.toISOString(),
  ...(data.updatedDate ? { dateModified: data.updatedDate.toISOString() } : {}),
  inLanguage: 'es-PA',
  mainEntityOfPage: canonical.href,
  url: canonical.href,
  author: { '@id': personId },
  ...(socialImageUrl ? { image: socialImageUrl.href } : {}),
};
const formatDate = (date: Date) => new Intl.DateTimeFormat('es-PA', { dateStyle: 'long' }).format(date);
---

<BaseLayout
  title={`${data.title} | Yoga Funcional Panamá`}
  description={data.description}
  canonical={canonical}
  ogType="article"
  socialImage={socialImageUrl}
  publishedTime={data.publishDate}
  modifiedTime={data.updatedDate}
  structuredData={articleStructuredData}
>
  <Header />
  <main id="contenido" class="blog-main">
    <article class="blog-article">
      <header class="blog-article-header">
        {data.category && <p>{data.category}</p>}
        <h1>{data.title}</h1>
        <p>{data.description}</p>
        <p>Por {data.author}</p>
        <time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>
        {data.updatedDate && <time datetime={data.updatedDate.toISOString()}>Actualizado: {formatDate(data.updatedDate)}</time>}
      </header>

      <div class="blog-body">
        <slot />
      </div>

      <footer class="blog-article-footer">
        {data.tags.length > 0 && <p>{data.tags.join(' · ')}</p>}
        <a href={`${base}blog/`}>Volver al Blog</a>
      </footer>
    </article>
  </main>
  <Footer />
</BaseLayout>
