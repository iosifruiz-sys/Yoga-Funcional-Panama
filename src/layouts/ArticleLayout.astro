---
import type { CollectionEntry } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro'; import ShareButton from '../components/ShareButton.astro';
import { slugForPost } from '../lib/blog'; import { ui, localizedPath, type Locale } from '../i18n'; import '../styles/blog.css';
interface Props { post:CollectionEntry<'blog'>; slug:string; locale:Locale; previousPost?:CollectionEntry<'blog'>; nextPost?:CollectionEntry<'blog'>; translationSlug?:string; translatedPost?:CollectionEntry<'blog'> }
const {post,slug,locale,previousPost,nextPost,translationSlug,translatedPost}=Astro.props; const {data}=post; const t=ui[locale].blog;
const articlePath=`blog/${slug}/`; const canonical=new URL(localizedPath(locale,articlePath),Astro.site); const translationLocale=locale==='es'?'ru':'es';
const alternateUrl=translationSlug ? localizedPath(translationLocale,`blog/${translationSlug}/`) : localizedPath(translationLocale,'blog/');
const alternates=translationSlug ? {es:locale==='es'?canonical:alternateUrl,ru:locale==='ru'?canonical:alternateUrl}:undefined;
const personId=`${new URL(import.meta.env.BASE_URL,Astro.site).href}#person`; const hasOwnImage=Boolean(data.socialImage||data.cover); const inheritedImage=!hasOwnImage?translatedPost?.data.socialImage??translatedPost?.data.cover?.image:undefined; const source=data.socialImage??data.cover?.image??inheritedImage; const cover=data.cover??(inheritedImage?{image:inheritedImage,alt:translatedPost?.data.cover?.alt??data.title}:undefined); const image=source?await getImage({src:source}):undefined; const socialImageUrl=image?new URL(image.src,Astro.site):undefined;
const articleStructuredData={'@type':'BlogPosting','@id':`${canonical.href}#article`,headline:data.title,description:data.description,datePublished:data.publishDate.toISOString(),...(data.updatedDate?{dateModified:data.updatedDate.toISOString()}:{}),inLanguage:locale==='es'?'es-PA':'ru',mainEntityOfPage:canonical.href,url:canonical.href,author:{'@id':personId},...(socialImageUrl?{image:socialImageUrl.href}:{})};
const formatDate=(date:Date)=>[date.getUTCDate(),date.getUTCMonth()+1,date.getUTCFullYear()].map(part=>String(part).padStart(2,'0')).join('.'); const blogUrl=localizedPath(locale,'blog/');
---
<BaseLayout title={`${data.title} | Yoga Funcional Panamá`} description={data.description} canonical={canonical} locale={locale} alternates={alternates} ogType="article" socialImage={socialImageUrl} socialImageAlt={cover?.alt} publishedTime={data.publishDate} modifiedTime={data.updatedDate} structuredData={articleStructuredData}>
<Header locale={locale} alternateUrl={alternateUrl}/><main id="contenido" class="blog-main blog-article-main"><article class="blog-article">
<div class="blog-article-actions"><a class="blog-back" href={blogUrl}>{t.back}</a></div>
<header class="blog-article-header">{data.category&&<p class="blog-article-category">{data.category}</p>}<h1>{data.title}</h1><p class="blog-article-description">{data.description}</p><div class="blog-article-meta"><p>{t.by} <a class="blog-author-link" href={`${localizedPath(locale)}#sobre-mi`}>{data.author}</a></p><time datetime={data.publishDate.toISOString()}>{formatDate(data.publishDate)}</time>{data.updatedDate&&<time datetime={data.updatedDate.toISOString()}>{t.updated}: {formatDate(data.updatedDate)}</time>}<ShareButton title={data.title} locale={locale}/></div></header>
{cover&&<figure class="blog-article-cover"><Image src={cover.image} alt={cover.alt} widths={[768,1200,1600]} sizes="100vw"/></figure>}<div class="blog-body"><slot/></div>
<footer class="blog-article-footer"><ShareButton title={data.title} locale={locale} prominent/><nav class="blog-article-navigation" aria-label={t.articleNav}>{(previousPost||nextPost)&&<div class="blog-adjacent-links">{previousPost&&<a class="blog-adjacent-link blog-adjacent-link--previous" href={`${blogUrl}${slugForPost(previousPost)}/`}><span class="blog-adjacent-direction">{t.previous}</span><span class="blog-adjacent-title">{previousPost.data.title}</span></a>}{nextPost&&<a class="blog-adjacent-link blog-adjacent-link--next" href={`${blogUrl}${slugForPost(nextPost)}/`}><span class="blog-adjacent-direction">{t.next}</span><span class="blog-adjacent-title">{nextPost.data.title}</span></a>}</div>}<a class="blog-all-articles" href={blogUrl}>{t.all}</a></nav></footer>
</article></main><Footer locale={locale}/></BaseLayout>
