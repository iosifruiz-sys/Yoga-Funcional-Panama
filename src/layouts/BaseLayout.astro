---
import '../styles/global.css';
import { ui, type Locale } from '../i18n';

interface Props {
  title: string;
  description: string;
  canonical?: URL | string;
  ogType?: 'website' | 'article';
  socialImage?: URL | string;
  socialImageAlt?: string;
  socialImageWidth?: number;
  socialImageHeight?: number;
  publishedTime?: Date;
  modifiedTime?: Date;
  structuredData?: Record<string, unknown>;
  locale?: Locale;
  alternates?: { es: URL | string; ru: URL | string };
}

const {
  title,
  description,
  canonical: canonicalProp,
  ogType = 'website',
  socialImage,
  socialImageAlt,
  socialImageWidth,
  socialImageHeight,
  publishedTime,
  modifiedTime,
  structuredData: additionalStructuredData,
  locale = 'es',
  alternates,
} = Astro.props;
const t = ui[locale];
const favicon = `${import.meta.env.BASE_URL}images/funcyo.png`;
const canonical = canonicalProp ? new URL(canonicalProp, Astro.site) : new URL(Astro.url.pathname, Astro.site);
const defaultSocialImage = `${import.meta.env.BASE_URL}images/og-image.png`;
const socialImageUrl = new URL(socialImage ?? defaultSocialImage, Astro.site);
const socialImageDescription = socialImageAlt ?? 'Yoga Funcional Panamá — Iosif Ruiz';
const socialImageDimensions = socialImage
  ? { width: socialImageWidth, height: socialImageHeight }
  : { width: 1200, height: 630 };
const siteHomepage = new URL(import.meta.env.BASE_URL, Astro.site);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteHomepage.href}#website`,
      url: siteHomepage.href,
      name: 'Yoga Funcional Panamá',
      inLanguage: locale === 'es' ? 'es-PA' : 'ru',
      author: { '@id': `${siteHomepage.href}#person` },
    },
    {
      '@type': 'Person',
      '@id': `${siteHomepage.href}#person`,
      name: 'Iosif Ruiz',
      url: siteHomepage.href,
      jobTitle: locale === 'es' ? 'Profesor de yoga y meditación' : 'Преподаватель йоги и медитации',
    },
    ...(additionalStructuredData ? [additionalStructuredData] : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-X7C60T7LBK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-X7C60T7LBK');
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#171714" />
    <link rel="icon" type="image/png" href={favicon} />
    <link rel="canonical" href={canonical} />
    {alternates && <link rel="alternate" hreflang="es" href={new URL(alternates.es, Astro.site)} />}
    {alternates && <link rel="alternate" hreflang="ru" href={new URL(alternates.ru, Astro.site)} />}
    {alternates && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, Astro.site)} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=League+Gothic&family=UnifrakturCook:wght@700&display=swap" rel="stylesheet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={locale === 'es' ? 'es_PA' : 'ru_RU'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Yoga Funcional Panamá" />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageDimensions.width && <meta property="og:image:width" content={String(socialImageDimensions.width)} />}
    {socialImageDimensions.height && <meta property="og:image:height" content={String(socialImageDimensions.height)} />}
    <meta property="og:image:alt" content={socialImageDescription} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={socialImageDescription} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <script is:inline>
      (() => {
        const authorModeKey = 'yfp-author-mode';
        const adminParameter = new URLSearchParams(window.location.search).get('admin');
        let authorModeEnabled = adminParameter === '1';

        try {
          if (adminParameter === '1') {
            localStorage.setItem(authorModeKey, '1');
          } else if (adminParameter === '0') {
            localStorage.removeItem(authorModeKey);
          } else {
            authorModeEnabled = localStorage.getItem(authorModeKey) === '1';
          }
        } catch {
          // Author mode is only a local convenience; the page must work without storage.
        }

        if (adminParameter === '0') authorModeEnabled = false;
        document.documentElement.toggleAttribute('data-author-mode', authorModeEnabled);
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">{t.skip}</a>
    <slot />
  </body>
</html>
