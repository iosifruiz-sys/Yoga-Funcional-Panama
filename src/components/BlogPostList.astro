---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { findTranslation, slugForPost } from '../lib/blog';
import { localizedBlogTagPath } from '../lib/blogTags';
import { ui, localizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  posts: CollectionEntry<'blog'>[];
  emptyMessage?: string;
}

const { locale, posts, emptyMessage } = Astro.props;
const t = ui[locale].blog;
const blogUrl = localizedPath(locale, 'blog/');
const cards = await Promise.all(posts.map(async (post) => ({
  post,
  cover: post.data.cover ?? (locale === 'ru' ? (await findTranslation(post, 'es'))?.data.cover : undefined),
})));
const formatDate = (date: Date) => [date.getUTCDate(), date.getUTCMonth()+1, date.getUTCFullYear()].map((part)=>String(part).padStart(2,'0')).join('.');
---

{cards.length ? <ol class="blog-list">{cards.map(({post,cover})=>{const href=`${blogUrl}${slugForPost(post)}/`;return <li><article class:list={['blog-list-entry',{'blog-list-entry--no-cover':!cover}]}>
  {cover && <a class="blog-list-image" href={href} aria-label={`${t.readLabel}: ${post.data.title}`}><Image src={cover.image} alt={cover.alt} widths={[640,960,1280]} sizes="(min-width: 62rem) 55vw, 100vw" /></a>}
  <div class="blog-list-content"><p class="blog-list-meta">{post.data.category ?? 'Blog'} <span aria-hidden="true">·</span>{' '}<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></p><p class="blog-post-tags">{post.data.tags.map((tag) => <a href={localizedBlogTagPath(locale, tag)} aria-label={`${t.tagLinkLabel}: ${t.tags[tag]}`}>#{t.tags[tag]}</a>)}</p><h2><a href={href}>{post.data.title}</a></h2><p class="blog-list-description">{post.data.description}</p><a class="blog-list-cta" href={href} aria-label={`${t.readLabel}: ${post.data.title}`}>{t.read} <span aria-hidden="true">→</span></a></div>
</article></li>})}</ol> : <p class="blog-empty">{emptyMessage ?? t.empty}</p>}
