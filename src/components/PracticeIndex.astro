---
import type { PracticeResource } from '../lib/resources';
interface Props { resources: PracticeResource[] }
const { resources } = Astro.props;
const labels = { pdf: 'PDF', video: 'VÍDEO', audio: 'AUDIO', questionnaire: 'CUESTIONARIO', test: 'TEST' };
---
<section class="practice-index" data-practice-index>
  <header class="practice-heading">
    <h1>RECURSOS</h1>
    <div class="practice-heading-meta">
      <p>INVENTARIO / ARSENAL DE PRÁCTICA</p>
      <p>MATERIAL PRÁCTICO PARA ENTRENAR</p>
    </div>
  </header>
  {resources.length ? (
    <div class="practice-workspace">
    <ol class="practice-list" aria-label="Recursos disponibles">
      {resources.map((resource, index) => (
        <li>
          <div class="practice-row" data-resource-row={resource.id}>
            <span class="practice-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
            {resource.article ? (
              <a class="practice-title" href={resource.article}>{resource.title}</a>
            ) : (
              <button type="button" class="practice-title" data-resource-open
                aria-haspopup="dialog" aria-controls="practice-preview" aria-expanded="false">{resource.title}</button>
            )}
            <span class="practice-kind">{labels[resource.type]}</span>
            <button type="button" class="practice-arrow" data-resource-open
              aria-label={`Abrir vista previa: ${resource.title}`} aria-haspopup="dialog"
              aria-controls="practice-preview" aria-expanded="false"><span aria-hidden="true">↗</span></button>
          </div>
          <noscript><a class="practice-fallback" href={resource.href} download={resource.download}>{resource.title} ↗</a></noscript>
        </li>
      ))}
    </ol>
    <aside class="practice-detail" id="practice-detail" aria-label="Vista del recurso seleccionado">
      <div class="practice-detail-head">
        <span data-detail-number>ITEM 001</span>
        <span data-detail-kind>{labels[resources[0].type]}</span>
      </div>
      <h2 data-detail-title>{resources[0].title}</h2>
      <div class="practice-detail-visual">
        <div class="practice-page-stack" data-detail-stack hidden={!resources[0].previewPages?.length} aria-label="Vista de las primeras páginas del PDF">
          {resources[0].previewPages?.map((page, index) => (
            <img src={page} alt={`Página ${index + 1} de ${resources[0].title}`} loading={index ? 'lazy' : 'eager'} style={`--page-index: ${index}; --page-count: ${resources[0].previewPages?.length ?? 0}`} />
          ))}
        </div>
        {resources[0].image ? <img data-detail-image src={resources[0].image} alt={resources[0].imageAlt ?? ''} hidden={!!resources[0].previewPages?.length} /> : <img data-detail-image alt="" hidden />}
        <div data-detail-fallback class:list={{ 'detail-hidden': !!(resources[0].image || resources[0].previewPages?.length) }} aria-hidden="true">
          <span>YOGA FUNCIONAL / RECURSOS</span>
          <strong data-detail-fallback-title>{resources[0].title}</strong>
        </div>
      </div>
      <div class="practice-detail-meta">
        <span>ARCHIVO / <strong data-detail-kind-meta>{labels[resources[0].type]}</strong></span>
        <span>ACCESO / <strong>LIBRE</strong></span>
      </div>
      <p data-detail-description>{resources[0].description}</p>
      <a class="practice-detail-action" data-detail-action href={resources[0].href} download={resources[0].download ? true : undefined}>{resources[0].download ? 'DESCARGAR PDF' : 'ABRIR RECURSO'} <span aria-hidden="true">↗</span></a>
      <a class="practice-detail-article" data-detail-article href={resources[0].article ?? undefined} hidden={!resources[0].article}>LEER ARTÍCULO ↗</a>
    </aside>
    </div>
  ) : <p class="practice-empty">Todavía no hay recursos publicados.</p>}
  <dialog id="practice-preview" class="practice-preview" aria-labelledby="practice-preview-title" aria-describedby="practice-preview-description">
    <button class="practice-close" type="button" aria-label="Cerrar vista previa">CERRAR <span aria-hidden="true">×</span></button>
    <div class="practice-preview-content" data-preview-content>
      <div class="practice-visual">
        <img data-preview-image alt="" hidden />
        <div class="practice-type-visual" data-preview-typography aria-hidden="true"><span>YOGA FUNCIONAL</span><strong data-preview-cover-title></strong></div>
      </div>
      <div class="practice-preview-copy">
        <p class="practice-preview-kind" data-preview-kind></p>
        <h2 id="practice-preview-title"></h2>
        <p id="practice-preview-description"></p>
        <a class="practice-action" data-preview-action></a>
        <a class="practice-article" data-preview-article hidden>LEER ARTÍCULO <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </dialog>
  <script type="application/json" data-practice-data set:html={JSON.stringify(resources).replace(/</g, '\\u003c')} />
</section>
<script>
  import { setupPracticeIndex } from '../scripts/practicePreview';
  document.querySelectorAll<HTMLElement>('[data-practice-index]').forEach(setupPracticeIndex);
</script>
<style>
  .practice-index { background: var(--color-light); min-height: calc(100svh - 4.25rem); padding: clamp(2rem, 6vw, 6rem) var(--gutter) clamp(3rem, 7vw, 7rem); }
  .practice-heading > p { margin: 0 0 2rem; font: 1.25rem var(--font-utility); letter-spacing: .05em; }
  .practice-heading h1 { margin: 0 0 clamp(3rem, 6vw, 6rem); font: 900 clamp(3.8rem, 9vw, 9rem)/.85 var(--font-display); text-transform: uppercase; letter-spacing: -.035em; }
  .practice-heading h1 > span { display: inline-block; margin-left: .2em; color: var(--color-orange); font-family: var(--font-body); font-size: .7em; }
  .practice-list { list-style: none; padding: 0; margin: 0; border-top: var(--border); }
  .practice-list > li { border-bottom: var(--border); }
  .practice-row { width: 100%; min-width: 0; display: grid; grid-template-columns: 3.5rem minmax(0, 1fr) auto 2rem; align-items: baseline; gap: 1rem; padding: 1.7rem 0; border: 0; color: inherit; background: transparent; text-align: left; }
  .practice-title, .practice-arrow { margin: 0; padding: 0; border: 0; background: transparent; color: inherit; text-align: inherit; text-decoration: none; cursor: pointer; }
  .practice-number { color: var(--color-orange); font: 1.6rem var(--font-utility); }
  .practice-title { font: 900 clamp(1.8rem, 4.1vw, 4.5rem)/1 var(--font-display); text-transform: uppercase; overflow-wrap: anywhere; }
  .practice-kind { font: 1.1rem var(--font-utility); letter-spacing: .04em; }
  .practice-arrow { font: 1.5rem var(--font-body); }
  .practice-row[data-active] .practice-arrow { color: var(--color-orange); }
  .practice-title:focus-visible, .practice-arrow:focus-visible { outline-offset: -4px; }
  .practice-fallback { display: block; padding: 1rem 0; }
  .practice-empty { border-block: var(--border); margin: 0; padding: 2rem 0; font-size: 1rem; }
  .practice-preview { position: fixed; inset: auto; margin: 0; padding: 0; width: min(26rem, calc(100vw - 2rem)); max-width: none; max-height: calc(100svh - 6.25rem); overflow: auto; overscroll-behavior: contain; border: var(--border); background: var(--color-warm); color: var(--color-dark); box-shadow: .5rem .5rem 0 var(--color-dark); opacity: 0; transform: translateY(6px) scale(.98); transform-origin: left center; transition: opacity 120ms cubic-bezier(.23,1,.32,1), transform 120ms cubic-bezier(.23,1,.32,1); z-index: 30; }
  .practice-preview[data-visible] { opacity: 1; transform: translateY(0) scale(1); transition-duration: 180ms; }
  .practice-close { display: flex; justify-content: space-between; align-items: center; width: 100%; padding: .65rem 1rem; border: 0; border-bottom: var(--border); background: var(--color-warm); color: inherit; font: 1rem var(--font-utility); letter-spacing: .04em; cursor: pointer; }
  .practice-close > span { font: 1.5rem/1 var(--font-body); }
  .practice-preview-content { opacity: 1; transition: opacity 120ms cubic-bezier(.23,1,.32,1); }
  .practice-preview-content[data-changing] { opacity: 0; }
  .practice-visual { border-bottom: var(--border); }
  .practice-visual img { display: block; width: 100%; height: 12rem; object-fit: contain; }
  .practice-visual img[hidden], .practice-type-visual[hidden], .practice-article[hidden] { display: none; }
  .practice-type-visual { padding: 1.25rem; min-height: 11rem; display: flex; flex-direction: column; justify-content: space-between; gap: 1.5rem; }
  .practice-type-visual > span { font: 1rem var(--font-utility); letter-spacing: .04em; }
  .practice-type-visual strong { max-width: 100%; font: 900 2.5rem/.95 var(--font-display); text-transform: uppercase; overflow-wrap: anywhere; }
  .practice-preview-copy { padding: 1.25rem; }
  .practice-preview-kind { margin: 0 0 1rem; font: 1.1rem var(--font-utility); letter-spacing: .05em; }
  .practice-preview-copy h2 { margin: 0; font: 700 1.25rem/1.2 var(--font-body); overflow-wrap: anywhere; }
  .practice-preview-copy > p:not(.practice-preview-kind) { font: .95rem/1.5 var(--font-body); margin: 1rem 0 1.5rem; }
  .practice-action { display: flex; justify-content: space-between; gap: 1rem; padding: .9rem 1rem; background: var(--color-orange); color: var(--color-dark); font: 700 .85rem var(--font-body); text-decoration: none; transition: transform 120ms cubic-bezier(.23,1,.32,1); }
  .practice-action:active { transform: scale(.98); }
  .practice-article { display: inline-block; margin-top: 1rem; font: 1rem var(--font-utility); letter-spacing: .03em; text-underline-offset: .2em; }
  .practice-preview::backdrop { background: rgba(23,23,20,.45); }
  :global(html.practice-sheet-open) { overflow: hidden; }
  .practice-preview[data-instant], .practice-preview[data-instant] .practice-preview-content { transition: none; }
  @media (hover: hover) and (pointer: fine) { .practice-row:hover .practice-arrow { color: var(--color-orange); } }
  @media (max-width: 61.999rem), (hover: none), (pointer: coarse) {
    .practice-preview { inset: auto 0 0; width: 100%; max-height: calc(100svh - 2rem); padding-bottom: env(safe-area-inset-bottom); border-bottom: 0; box-shadow: none; transform: translateY(12px); }
    .practice-preview[data-visible] { transform: translateY(0); }
  }
  @media (max-width: 37.5rem) {
    .practice-heading h1 { font-size: clamp(3.2rem, 14vw, 5rem); }
    .practice-row { grid-template-columns: 2rem minmax(0, 1fr) 1.5rem; gap: .65rem; padding: 1.25rem 0; }
    .practice-number { font-size: 1.3rem; }
    .practice-title { font-size: clamp(1.5rem, 7vw, 2.5rem); }
    .practice-kind { grid-column: 2; grid-row: 2; font-size: .95rem; }
    .practice-arrow { grid-column: 3; grid-row: 1; }
  }

  /* Desktop equipment inventory; original dialog remains for mobile/touch. */
  .practice-index { padding: 0 0 clamp(3rem, 6vw, 6rem); }
  .practice-heading { padding: clamp(1.5rem, 3vw, 3rem) var(--gutter) 1.4rem; border-bottom: var(--border); }
  .practice-heading h1 { margin: 0; font-size: clamp(4rem, 12.5vw, 13rem); line-height: .79; letter-spacing: -.04em; overflow-wrap: anywhere; }
  .practice-heading-meta { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-top: 1.3rem; }
  .practice-heading-meta p { margin: 0; font: 1rem var(--font-utility); letter-spacing: .055em; }
  .practice-workspace { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 58%); align-items: stretch; }
  .practice-list { border-top: 0; }
  .practice-list > li { border-bottom: var(--border); }
  .practice-row { min-height: 11rem; padding: 1.75rem var(--gutter); grid-template-columns: minmax(0, 1fr) auto; grid-template-rows: auto 1fr auto; gap: .6rem; align-items: start; }
  .practice-number { grid-column: 1; grid-row: 1; font-size: 1.1rem; }
  .practice-number::before { content: 'ITEM '; }
  .practice-title { grid-column: 1 / 3; grid-row: 2; font-size: clamp(1.75rem, 3.1vw, 3.25rem); }
  .practice-kind { grid-column: 1; grid-row: 3; font-size: 1rem; }
  .practice-arrow { grid-column: 2; grid-row: 3; justify-self: end; }
  .practice-row[data-active] { background: var(--color-orange); }
  .practice-row[data-active] .practice-number, .practice-row[data-active] .practice-arrow { color: var(--color-dark); }
  .practice-detail { min-width: 0; border-left: var(--border); padding: clamp(1rem, 2.5vw, 3rem); align-self: stretch; }
  .practice-detail-head { display: flex; justify-content: space-between; font: 1.05rem var(--font-utility); }
  .practice-detail h2 { margin: .8rem 0 1.5rem; font: 900 clamp(2rem, 2.8vw, 3.25rem)/.95 var(--font-display); text-transform: uppercase; overflow-wrap: anywhere; }
  .practice-detail-visual { min-height: 15rem; display: grid; place-items: center; background: var(--color-warm); border: var(--border); overflow: hidden; }
  .practice-detail-visual img { display: block; max-width: 100%; width: 100%; max-height: 26rem; object-fit: contain; }
  .practice-detail-visual img[hidden], .practice-detail-visual .detail-hidden, .practice-detail-article[hidden] { display: none; }
  .practice-detail-visual > div { width: 100%; min-height: 17rem; padding: 1.5rem; display: flex; flex-direction: column; justify-content: space-between; gap: 2rem; }
  .practice-detail-visual > div span { font: 1rem var(--font-utility); }
  .practice-detail-visual > div strong { font: 900 clamp(2rem, 4vw, 4rem)/.9 var(--font-display); text-transform: uppercase; overflow-wrap: anywhere; }
  .practice-detail-meta { display: flex; gap: 1.5rem; flex-wrap: wrap; padding: 1rem 0; border-bottom: var(--border); font: 1rem var(--font-utility); }
  .practice-detail > p { margin: 1.5rem 0; font: 1rem/1.5 var(--font-body); }
  .practice-detail-action { display: flex; justify-content: space-between; gap: 1rem; background: var(--color-orange); color: var(--color-dark); padding: 1rem; font: 700 1rem var(--font-body); text-decoration: none; }
  .practice-detail-article { display: inline-block; margin-top: 1rem; color: inherit; font: 1rem var(--font-utility); }
  @media (max-width: 61.999rem), (hover: none), (pointer: coarse) {
    .practice-workspace { display: block; }
    .practice-detail { display: none; }
    .practice-heading-meta p:last-child { display: none; }
    .practice-row { min-height: 0; }
    .practice-row[data-active] { background: transparent; }
    .practice-row[data-active] .practice-number, .practice-row[data-active] .practice-arrow { color: var(--color-orange); }
  }
  @media (max-width: 37.5rem) {
    .practice-heading h1 { font-size: clamp(3.5rem, 16vw, 6rem); }
    .practice-heading-meta { margin-top: .75rem; }
    .practice-row { grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem; grid-template-rows: auto auto; padding: 1.25rem var(--gutter); gap: .5rem; }
    .practice-number { grid-column: 1; grid-row: 1; }
    .practice-number::before { content: ''; }
    .practice-title { grid-column: 2; grid-row: 1; font-size: clamp(1.5rem, 7vw, 2.5rem); }
    .practice-kind { grid-column: 2; grid-row: 2; }
    .practice-arrow { grid-column: 3; grid-row: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .practice-preview, .practice-preview[data-visible] { transform: none; transition: opacity 100ms ease; }
    .practice-preview-content { transition-duration: 100ms; }
    .practice-action { transition: none; }
    .practice-action:active { transform: none; }
  }

  /* Four small real PDF pages. Explicit positions avoid unsupported calc() multiplication. */
  .practice-detail-visual { overflow: hidden; }
  .practice-detail-visual > .practice-page-stack {
    position: relative; box-sizing: border-box; width: 100%; min-height: 0;
    height: clamp(15rem, 24vw, 21rem); display: block; padding: 0;
    background: var(--color-warm);
  }
  .practice-detail-visual > .practice-page-stack[hidden] { display: none; }
  .practice-detail-visual .practice-page-stack :global(img) {
    position: absolute; display: block; width: 32%; height: 78%;
    max-width: 15rem; max-height: 17rem; top: 10%; left: 6%;
    object-fit: contain; object-position: center; background: #f5f1e8;
    box-shadow: .25rem .4rem .75rem rgba(0,0,0,.16);
    border: 1px solid rgba(0,0,0,.12);
    transform: rotate(-2deg); transition: transform 200ms ease;
  }
  .practice-detail-visual .practice-page-stack :global(img):nth-child(1) { left: 6%; top: 11%; z-index: 4; transform: rotate(-3deg); }
  .practice-detail-visual .practice-page-stack :global(img):nth-child(2) { left: 26%; top: 9%; z-index: 3; transform: rotate(-1deg); }
  .practice-detail-visual .practice-page-stack :global(img):nth-child(3) { left: 46%; top: 11%; z-index: 2; transform: rotate(1deg); }
  .practice-detail-visual .practice-page-stack :global(img):nth-child(4) { left: 65%; top: 13%; z-index: 1; transform: rotate(3deg); }
  /* A missing/short PDF gets a thumbnail, never a full-width cover. */
  .practice-detail-visual > img[data-detail-image] {
    box-sizing: border-box; width: auto; max-width: min(42%, 16rem);
    height: auto; max-height: 15rem; margin: 1.5rem auto;
    object-fit: contain; box-shadow: .25rem .4rem .75rem rgba(0,0,0,.14);
  }
  .practice-detail-visual > img[data-detail-image][hidden] { display: none; }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .practice-page-stack:hover :global(img):nth-child(1) { transform: translateX(-.3rem) rotate(-4deg); }
    .practice-page-stack:hover :global(img):nth-child(2) { transform: translateX(.2rem) rotate(-1deg); }
    .practice-page-stack:hover :global(img):nth-child(3) { transform: translateX(.4rem) rotate(2deg); }
    .practice-page-stack:hover :global(img):nth-child(4) { transform: translateX(.6rem) rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) { .practice-detail-visual .practice-page-stack :global(img) { transition: none; } }
  @media (min-width: 62rem) and (hover: hover) and (pointer: fine) {
    .practice-heading { padding-top: 1.25rem; padding-bottom: .75rem; }
    .practice-heading h1 { font-size: clamp(4rem, 16vw, 16rem); }
    .practice-heading-meta { margin-top: .5rem; }
    .practice-detail { padding: 1.25rem clamp(1rem, 2.5vw, 3rem); }
    .practice-detail h2 { margin: .4rem 0 .65rem; }
    .practice-detail-visual { border: 0; }
    .practice-detail-visual > .practice-page-stack { height: 19rem; }
    .practice-detail-visual .practice-page-stack :global(img) { height: 92%; max-width: 16rem; max-height: 18rem; }
    .practice-detail-visual .practice-page-stack :global(img):nth-child(1) { top: 4%; }
    .practice-detail-visual .practice-page-stack :global(img):nth-child(2) { top: 3%; }
    .practice-detail-visual .practice-page-stack :global(img):nth-child(3) { top: 4%; }
    .practice-detail-visual .practice-page-stack :global(img):nth-child(4) { top: 5%; }
    .practice-detail-meta { padding: .65rem 0; }
    .practice-detail > p { margin: .75rem 0; }
  }
</style>
