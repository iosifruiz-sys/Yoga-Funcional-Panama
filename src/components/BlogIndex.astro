---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import BlogPostList from './BlogPostList.astro';
import { getPublishedPosts } from '../lib/blog';
import { FEATURED_BLOG_TAGS, localizedBlogTagPath } from '../lib/blogTags';
import { ui, localizedPath, type Locale } from '../i18n';
import '../styles/blog.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale].blog;
const posts = await getPublishedPosts(locale);
const blogUrl = localizedPath(locale, 'blog/');
const alternateBlog = localizedPath(locale === 'es' ? 'ru' : 'es', 'blog/');
const canonical = new URL(blogUrl, Astro.site);
const collectionStructuredData = {
  '@type': 'CollectionPage',
  '@id': `${canonical.href}#collectionpage`,
  url: canonical.href,
  name: t.title,
  description: t.description,
  inLanguage: locale === 'es' ? 'es-PA' : 'ru',
  isPartOf: { '@id': `${new URL(import.meta.env.BASE_URL, Astro.site).href}#website` },
};
---
<BaseLayout title={t.title} description={t.description} locale={locale} alternates={{es:localizedPath('es','blog/'),ru:localizedPath('ru','blog/')}} structuredData={collectionStructuredData}>
  <Header locale={locale} alternateUrl={alternateBlog} />
  <main id="contenido" class="blog-main blog-index">
    <header class="blog-index-header"><h1 class="blog-section-marker">07 / BLOG</h1><nav class="blog-taxonomy" aria-label={t.tagsLabel}>{FEATURED_BLOG_TAGS.map((tag) => <a href={localizedBlogTagPath(locale, tag)} aria-label={`${t.tagLinkLabel}: ${t.tags[tag]}`}>#{t.tags[tag]}</a>)}</nav></header>
    <BlogPostList locale={locale} posts={posts} />
  </main><Footer locale={locale} />
</BaseLayout>
