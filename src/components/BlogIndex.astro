---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import { getPublishedPosts, slugForPost } from '../lib/blog';
import { ui, localizedPath, type Locale } from '../i18n';
import '../styles/blog.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = ui[locale].blog;
const posts = await getPublishedPosts(locale);
const blogUrl = localizedPath(locale, 'blog/');
const alternateBlog = localizedPath(locale === 'es' ? 'ru' : 'es', 'blog/');
const formatDate = (date: Date) => [date.getUTCDate(), date.getUTCMonth()+1, date.getUTCFullYear()].map((part)=>String(part).padStart(2,'0')).join('.');
const canonical = new URL(blogUrl, Astro.site);
const collectionStructuredData = {
  '@type': 'CollectionPage',
  '@id': `${canonical.href}#collectionpage`,
  url: canonical.href,
  name: t.title,
  description: t.description,
  inLanguage: locale === 'es' ? 'es-PA' : 'ru',
  isPartOf: { '@id': `${new URL(import.meta.env.BASE_URL, Astro.site).href}#website` },
};
---
<BaseLayout title={t.title} description={t.description} locale={locale} alternates={{es:localizedPath('es','blog/'),ru:localizedPath('ru','blog/')}} structuredData={collectionStructuredData}>
  <Header locale={locale} alternateUrl={alternateBlog} />
  <main id="contenido" class="blog-main blog-index">
    <header class="blog-index-header"><h1 class="blog-section-marker">07 / BLOG</h1><p class="blog-taxonomy">{t.taxonomy}</p></header>
    {posts.length ? <ol class="blog-list">{posts.map((post)=>{const href=`${blogUrl}${slugForPost(post)}/`;return <li><article class:list={['blog-list-entry',{'blog-list-entry--no-cover':!post.data.cover}]}>
      {post.data.cover && <a class="blog-list-image" href={href} aria-label={`${t.readLabel}: ${post.data.title}`}><Image src={post.data.cover.image} alt={post.data.cover.alt} widths={[640,960,1280]} sizes="(min-width: 62rem) 55vw, 100vw" /></a>}
      <div class="blog-list-content"><p class="blog-list-meta">{post.data.category ?? 'Blog'} <span aria-hidden="true">·</span>{' '}<time datetime={post.data.publishDate.toISOString()}>{formatDate(post.data.publishDate)}</time></p><h2><a href={href}>{post.data.title}</a></h2><p class="blog-list-description">{post.data.description}</p><a class="blog-list-cta" href={href} aria-label={`${t.readLabel}: ${post.data.title}`}>{t.read} <span aria-hidden="true">→</span></a></div>
    </article></li>})}</ol> : <p class="blog-empty">{t.empty}</p>}
  </main><Footer locale={locale} />
</BaseLayout>
