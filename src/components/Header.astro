---
import { ui, localizedPath, type Locale } from '../i18n';
interface Props { locale?: Locale; alternateUrl?: string }
const { locale = 'es', alternateUrl } = Astro.props;
const t = ui[locale];
const home = localizedPath(locale);
const links = [
  [t.nav[0], `${home}#metodo`], [t.nav[1], `${home}#clases`],
  [t.nav[2], `${home}#horarios`], [t.nav[3], `${home}#sobre-mi`],
  [t.nav[4], localizedPath(locale, 'blog/')],
];
const fallbackAlternate = localizedPath(locale === 'es' ? 'ru' : 'es');
const bookingUrl = 'https://wa.me/50762331434?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20las%20clases%20de%20Yoga%20Funcional.';
---
<header class="site-header">
  <button class="menu-toggle" type="button" aria-label={t.openMenu} data-open-label={t.openMenu} data-close-label={t.closeMenu} aria-expanded="false" aria-controls="mobile-navigation"><span></span><span></span><span></span></button>
  <a class="brand" href={home} aria-label={t.homeLabel}><span>Yoga Funcional</span></a>
  <nav id="mobile-navigation" aria-label={t.mainNav}>
    <ul>
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
      <li class="language-switcher" aria-label="Language"><a href={locale === 'es' ? Astro.url.pathname : (alternateUrl ?? fallbackAlternate)} aria-current={locale === 'es' ? 'page' : undefined}>ES</a><span aria-hidden="true">|</span><a href={locale === 'ru' ? Astro.url.pathname : (alternateUrl ?? fallbackAlternate)} aria-current={locale === 'ru' ? 'page' : undefined}>RU</a></li>
    </ul>
  </nav>
  <a class="header-cta" href={bookingUrl} target="_blank" rel="noopener noreferrer">{t.reserve} <span aria-hidden="true">↗</span></a>
</header>
<script>
  const header = document.querySelector<HTMLElement>('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = header?.querySelector<HTMLElement>('nav');
  const reserve = header?.querySelector<HTMLAnchorElement>('.header-cta');
  const mobileQuery = window.matchMedia('(max-width: 61.999rem)');
  const setMenuState = (open: boolean) => {
    if (!header || !toggle || !navigation) return;
    header.classList.toggle('menu-open', open); toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? toggle.dataset.closeLabel! : toggle.dataset.openLabel!);
    navigation.toggleAttribute('inert', mobileQuery.matches && !open); document.body.classList.toggle('menu-open', open);
  };
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; setMenuState(open); if (open) navigation?.querySelector<HTMLAnchorElement>('a')?.focus(); });
  navigation?.addEventListener('click', (event) => { if ((event.target as Element).closest('a')) setMenuState(false); }); reserve?.addEventListener('click', () => setMenuState(false));
  document.addEventListener('keydown', (event) => { const open = toggle?.getAttribute('aria-expanded') === 'true'; if (event.key === 'Escape' && open) { setMenuState(false); toggle!.focus(); } if (event.key === 'Tab' && open && header && toggle && navigation) { const last = reserve ?? navigation.querySelector<HTMLAnchorElement>('a:last-child'); if (event.shiftKey && document.activeElement === toggle && last) { event.preventDefault(); last.focus(); } else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); toggle.focus(); } } });
  mobileQuery.addEventListener('change', () => setMenuState(false)); setMenuState(false);
</script>
