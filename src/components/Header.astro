---
const base = import.meta.env.BASE_URL;
const links = [
  ['Método', '#metodo'],
  ['Clases', '#proximamente'],
  ['Horarios', '#proximamente'],
  ['Sobre mí', '#proximamente'],
  ['Blog', '#proximamente'],
];
const bookingUrl = import.meta.env.PUBLIC_WHATSAPP_URL || '#reservar';
---

<header class="site-header">
  <a class="brand" href={base} aria-label="Yoga Funcional Panamá, inicio">
    <span>YF</span><b>PTY</b>
  </a>
  <nav aria-label="Navegación principal">
    <ul>
      {links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}
    </ul>
  </nav>
  <a class="header-cta" href={bookingUrl}>Reservar <span aria-hidden="true">↗</span></a>
</header>
