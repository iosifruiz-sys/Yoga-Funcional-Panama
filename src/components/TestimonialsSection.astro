---
import type { Locale } from '../i18n';
import es from '../data/testimonials/es.json';
import ru from '../data/testimonials/ru.json';
import { localizedPath } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = locale === 'es' ? es : ru;
interface Review {
  author: string; quote: Record<Locale, string>; url: string; source: string;
  rating: number; originalLanguage: string; note: Record<Locale, string>;
  order: number; published: boolean;
}
const entries = import.meta.glob<{ default: Review }>('../data/testimonials/reviews/*.json', { eager: true });
const reviews = Object.entries(entries).map(([key, entry]) => ({ ...entry.default, key }))
  .filter(review => review.published)
  .sort((a, b) => a.order - b.order || a.key.localeCompare(b.key));
---
<section id="testimonios" class="testimonials" aria-labelledby="testimonials-title" data-schedule-url={`${localizedPath(locale, 'clases/estudio/')}#studio-schedule`}>
  <header class="testimonials-intro">
    <h2 id="testimonials-title">{t.number}</h2>
  </header>
  <div class="testimonials-grid">
    {reviews.map(review => (
      <figure class="testimonial">
        <span class="testimonial-quote-mark" aria-hidden="true">“</span>
        <blockquote cite={review.url}><p>{review.quote[locale]}</p></blockquote>
        <figcaption>
          <a class="testimonial-author" href={review.url} target="_blank" rel="noopener noreferrer">{review.author}</a>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
<script>
  // Preserve existing article links/bookmarks to the retired homepage schedule.
  const followScheduleLink = () => {
    const target = document.querySelector<HTMLElement>('.testimonials')?.dataset.scheduleUrl;
    if (location.hash === '#horarios' && target) location.replace(target);
  };
  followScheduleLink();
  window.addEventListener('hashchange', followScheduleLink);
  document.addEventListener('astro:page-load', followScheduleLink);
</script>
<style>
  .testimonials { background: var(--color-light); color: var(--color-dark); border-top: var(--border); }
  .testimonials-intro { display: flex; align-items: center; gap: 1.5rem; padding: 1.5rem var(--gutter); }
  .testimonials-intro::after { content: ''; flex: 1; border-top: 2px solid var(--color-dark); }
  h2 { margin: 0; font: clamp(1.5rem, 2.5vw, 2.25rem)/1.1 var(--font-utility); text-transform: uppercase; }
  .testimonials-grid { display: grid; border-top: 1px solid var(--color-dark); }
  .testimonial { min-width: 0; margin: 0; padding: 1.5rem 1.25rem; display: flex; flex-direction: column; gap: 1rem; border-right: 1px solid var(--color-dark); border-bottom: 1px solid var(--color-dark); }
  .testimonial:nth-child(even) { background: var(--color-warm); }
  .testimonial-quote-mark { height: 2.75rem; color: var(--color-orange); font: 10rem/1 var(--font-display); }
  blockquote { grid-column: auto; grid-row: auto; align-self: auto; margin: 0; padding: 0; font: italic 500 1.125rem/1.5 var(--font-body); }
  blockquote p { margin: 0; }
  figcaption { margin-top: auto; padding-top: 1rem; border-top: 1px solid var(--color-dark); }
  .testimonial-author { display: inline; font: 1.75rem/1.2 var(--font-utility); text-transform: uppercase; overflow-wrap: anywhere; text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: .2em; transition: color 160ms ease; }
  @media (hover: hover) and (pointer: fine) {
    .testimonial-author:hover { color: var(--color-orange); }
  }
  @media (min-width: 40rem) { .testimonials-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .testimonials-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .testimonial:nth-child(n) { background: var(--color-light); }
    .testimonial:nth-child(3n + 2) { background: var(--color-warm); }
  }
  @media (min-width: 90rem) {
    .testimonials-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .testimonial:nth-child(n) { background: var(--color-light); }
    .testimonial:nth-child(even) { background: var(--color-warm); }
  }
  @media (prefers-reduced-motion: reduce) { .testimonial-author { transition: none; } }
</style>
