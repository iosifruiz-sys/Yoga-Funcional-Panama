---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const personalBookingUrl = 'https://wa.me/50762331434?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20las%20clases%20de%20Yoga%20Funcional.';

const formats = [
  {
    number: '01',
    name: t.classes.formats[0][0],
    paragraphs: [
      t.classes.formats[0][1],
      t.classes.formats[0][2],
    ],
    action: t.classes.formats[0][3],
    href: '#horarios',
  },
  {
    number: '02',
    name: t.classes.formats[1][0],
    price: '$30',
    paragraphs: [
      t.classes.formats[1][1],
      t.classes.formats[1][2],
    ],
    action: t.reserve,
    href: personalBookingUrl,
  },
  {
    number: '03',
    name: t.classes.formats[2][0],
    price: '$60',
    paragraphs: [
      t.classes.formats[2][1],
      t.classes.formats[2][2],
    ],
    action: t.reserve,
    href: personalBookingUrl,
  },
];
---

<section id="clases" class="classes" aria-labelledby="classes-title">
  <header class="classes-intro">
    <p class="classes-number">{t.classes.number}</p>
    <h2 id="classes-title"><span>{t.classes.title[0]}</span><span>{t.classes.title[1]}</span></h2>
  </header>

  <div class="class-formats">
    {formats.map((format) => (
      <article class="class-format">
        <p class="format-number">{format.number} /</p>
        <h3>{format.name}</h3>
        {format.price && <p class="format-price">{format.price}</p>}
        <div class="format-copy">
          {format.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <a
          class="format-action"
          href={format.href}
          target={format.href === personalBookingUrl ? '_blank' : undefined}
          rel={format.href === personalBookingUrl ? 'noopener noreferrer' : undefined}
        >{format.action} <span aria-hidden="true">→</span></a>
      </article>
    ))}
  </div>
</section>
