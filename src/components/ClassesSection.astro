---
import { localizedPath, type Locale } from '../i18n';
import { locations } from '../data/classes/locations';
import { classBookingUrl } from '../lib/class-booking';
import classesEs from '../data/classes/es.json';
import classesRu from '../data/classes/ru.json';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const classes = { es: classesEs, ru: classesRu }[locale];
const descriptions = (['estudio', 'domicilio', 'online'] as const).map(place => ({
  name: locations[locale][place].title, text: locations[locale][place].summary,
  action: locations[locale][place].readMore, place,
}));
---
<section id="clases" class="location-catalog" aria-labelledby="classes-title">
  <header class="catalog-intro">
    <p class="catalog-number">{classes.number}</p>
    <h2 id="classes-title"><span>{classes.title.first}</span><span>{classes.title.second}</span></h2>
  </header>
  <div class="catalog-rows" data-classes-circle>
    <div class="catalog-orb" aria-hidden="true"></div>
    {descriptions.map((format, index) => (
      <article class="catalog-row">
        <p class="catalog-number">0{index + 1} /</p>
        <h3>{format.name}</h3>
        <div class="catalog-copy"><p>{format.text}</p>
          <div class="catalog-actions">
            <a class="catalog-button primary" href={classBookingUrl(locale, format.place)} target="_blank" rel="noopener noreferrer">{locale === 'es' ? 'RESERVAR' : 'ЗАПИСАТЬСЯ'} <span aria-hidden="true">↗</span></a>
            <a class="catalog-button" href={localizedPath(locale, `clases/${format.place}/`)}>{format.action} <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
<script>
  import { initClassesCircles, disposeClassesCircles } from '../scripts/classes-circle';
  initClassesCircles();
  document.addEventListener('astro:page-load', initClassesCircles);
  document.addEventListener('astro:before-swap', disposeClassesCircles);
  window.addEventListener('pagehide', disposeClassesCircles);
  window.addEventListener('pageshow', initClassesCircles);
</script>
<style>
  .location-catalog { background: var(--color-light); color: var(--color-dark); border-top: var(--border); }
  .catalog-intro { padding: 2.5rem var(--gutter); }
  .catalog-number { margin: 0; font: 1.25rem var(--font-utility); letter-spacing: .05em; }
  .catalog-intro .catalog-number { margin-bottom: 1.5rem; }
  h2 { margin: 0; font: 900 clamp(3rem, 8vw, 7rem)/1 var(--font-display); text-transform: uppercase; letter-spacing: -.035em; }
  h2 span { display: block; }
  h2 span:last-child { color: var(--color-orange); }
  .catalog-rows { position: relative; isolation: isolate; overflow: hidden; border-top: var(--border); }
  .catalog-orb { display: none; position: absolute; left: 0; top: 0; z-index: 0; border-radius: 50%; background: var(--color-orange); opacity: 0; pointer-events: none; transform-origin: center; will-change: transform, opacity; }
  .catalog-row { position: relative; z-index: 1; display: grid; gap: .85rem; padding: 1.75rem var(--gutter); }
  .catalog-row + .catalog-row { border-top: var(--border); }
  h3 { margin: 0; font: clamp(2.25rem, 6vw, 4rem)/1.1 var(--font-utility); text-transform: uppercase; overflow-wrap: anywhere; }
  .catalog-copy { min-width: 0; display: flex; flex-direction: column; }
  .catalog-copy p { margin: 0; max-width: 38rem; font-size: 1rem; line-height: 1.5; }
  .catalog-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.25rem; }
  .catalog-button { flex: 1 1 9rem; display: flex; align-items: center; justify-content: space-between; gap: .75rem; min-height: 3rem; padding: .65rem .85rem; border: 1px solid var(--color-dark); font: 1.15rem var(--font-utility); text-transform: uppercase; text-decoration: none; }
  .primary { background: var(--color-orange); color: var(--color-dark); }
  .primary:focus-visible { background: var(--color-dark); color: var(--color-light); }
  @media (hover: hover) and (pointer: fine) {
    .primary { transition: color .18s ease, background-color .18s ease; }
    .primary:hover { background: var(--color-dark); color: var(--color-light); }
  }
  @media (min-width: 62rem) and (hover: hover) and (pointer: fine) {
    .catalog-intro { padding-block: 3.5rem; }
    .catalog-rows { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--color-warm); }
    .catalog-row { min-width: 0; grid-template-rows: auto auto 1fr; gap: 1.5rem; padding: 2rem clamp(1.25rem, 2.2vw, 2.75rem); }
    .catalog-row + .catalog-row { border-top: 0; border-left: var(--border); }
    h3 { font-size: clamp(3rem, 4.8vw, 5rem); line-height: 1; }
    .catalog-copy p { font-size: 1.125rem; }
    .catalog-actions { padding-top: 1.5rem; margin-top: auto; }
    .catalog-button { flex: 1 1 9rem; }
  }
  @media (min-width: 62rem) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .catalog-orb { display: block; }
  }
</style>
