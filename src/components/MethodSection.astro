---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const concepts = t.method.concepts;
const descriptions = t.method.descriptions;

---

<section id="metodo" class="method" aria-labelledby="method-title">
  <div class="method-intro">
    <p class="section-number">{t.method.number}</p>
    <h2 id="method-title"><span>{t.method.title[0]}</span><span><span class="method-line method-line-middle">{t.method.title[1]}</span> <span class="method-line method-line-last">{t.method.title[2]}</span></span></h2>
    <p class="method-copy">{t.method.copy}<br /><br />{t.method.copy2}<br /><strong>{t.method.copy3}</strong></p>
  </div>

  <ol class="concepts" aria-label={t.method.label}>
    {concepts.map((concept, index) => (
      <li style={`--index:${index}`}>
        <button
          class="concept-toggle"
          type="button"
          aria-expanded="false"
          aria-controls={`concept-panel-${index + 1}`}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{concept}</strong>
          <i aria-hidden="true">+</i>
        </button>
        <div class="concept-panel" id={`concept-panel-${index + 1}`} hidden>
          <p>{descriptions[index]}</p>
        </div>
      </li>
    ))}
  </ol>
  <div id="proximamente" class="end-note">{t.method.end}</div>
</section>

<script>
  const conceptToggles = document.querySelectorAll<HTMLButtonElement>('.concept-toggle');

  const setConceptState = (toggle: HTMLButtonElement, open: boolean) => {
    const panelId = toggle.getAttribute('aria-controls');
    const panel = panelId ? document.getElementById(panelId) : null;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('i')!.textContent = open ? '−' : '+';
    if (panel) panel.hidden = !open;
  };

  conceptToggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
      conceptToggles.forEach((item) => setConceptState(item, item === toggle && shouldOpen));
    });
  });
</script>
