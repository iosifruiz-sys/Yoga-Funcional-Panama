---
import type { Locale } from '../i18n';
import methodEs from '../data/method/es.json';
import methodRu from '../data/method/ru.json';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const method = { es: methodEs, ru: methodRu }[locale];
const qualityOrder = ['strength', 'mobility', 'balance', 'coordination', 'breathing', 'attention', 'recovery'] as const;
const concepts = qualityOrder.map((key) => method.qualities[key]);

---

<section id="metodo" class="method" aria-labelledby="method-title">
  <div class="method-intro">
    <p class="section-number">{method.number}</p>
    <h2 id="method-title"><span>{method.title.first}</span><span><span class="method-line method-line-middle">{method.title.middle}</span> <span class="method-line method-line-last">{method.title.last}</span></span></h2>
    <p class="method-copy">{method.copy}<br /><br />{method.copy2}<br /><strong>{method.copy3}</strong></p>
  </div>

  <ol class="concepts" aria-label={method.label}>
    {concepts.map((concept, index) => (
      <li style={`--index:${index}`}>
        <button
          class="concept-toggle"
          type="button"
          aria-expanded="false"
          aria-controls={`concept-panel-${index + 1}`}
        >
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{concept.name}</strong>
          <i aria-hidden="true">+</i>
        </button>
        <div class="concept-panel" id={`concept-panel-${index + 1}`} hidden>
          <p>{concept.description}</p>
        </div>
      </li>
    ))}
  </ol>
  <div id="proximamente" class="end-note">{method.end}</div>
</section>

<script>
  const conceptToggles = document.querySelectorAll<HTMLButtonElement>('.concept-toggle');

  const setConceptState = (toggle: HTMLButtonElement, open: boolean) => {
    const panelId = toggle.getAttribute('aria-controls');
    const panel = panelId ? document.getElementById(panelId) : null;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.querySelector('i')!.textContent = open ? '−' : '+';
    if (panel) panel.hidden = !open;
  };

  conceptToggles.forEach((toggle) => {
    toggle.addEventListener('click', () => {
      const shouldOpen = toggle.getAttribute('aria-expanded') !== 'true';
      conceptToggles.forEach((item) => setConceptState(item, item === toggle && shouldOpen));
    });
  });
</script>
