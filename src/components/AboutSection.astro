---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const base = import.meta.env.BASE_URL;
---

<section id="sobre-mi" class="about" aria-labelledby="about-title">
  <header class="about-header">
    <p class="about-number">{t.about.number}</p>
    <h2 id="about-title" class="about-title"><span>Iosif</span> <strong>Ruiz</strong></h2>
  </header>

  <div class="about-reveal">
    <div class="about-stage">
      <div class="about-visual-track">
        <div class="about-visual">
          <span class="about-circle"></span>
          <img src={`${base}images/IMG_6376.png`} alt={t.about.alt} loading="lazy" decoding="async" />
        </div>
      </div>

      <div class="about-copy about-copy-primary">
        <p class="about-intro">{t.about.intro}</p>
        {t.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>

      <p class="about-statement">
        <span>{t.about.statement[0]}</span>
        <strong>{t.about.statement[1]}</strong>
      </p>
    </div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.about');
  const reveal = section?.querySelector<HTMLElement>('.about-reveal');
  const mobileTrack = section?.querySelector<HTMLElement>('.about-visual-track');
  const mobileLayout = window.matchMedia('(max-width: 37.5rem)');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  let frame = 0;

  const updateReveal = () => {
    frame = 0;
    if (!section || !reveal) return;
    if (reduceMotion.matches) {
      section.style.setProperty('--about-progress', '1');
      return;
    }

    const progressArea = mobileLayout.matches && mobileTrack ? mobileTrack : reveal;
    const bounds = progressArea.getBoundingClientRect();
    const distance = Math.max(1, progressArea.offsetHeight - window.innerHeight);
    const progress = Math.min(1, Math.max(0, -bounds.top / distance));
    section.style.setProperty('--about-progress', progress.toFixed(3));
  };

  const requestUpdate = () => {
    if (!frame) frame = requestAnimationFrame(updateReveal);
  };

  window.addEventListener('scroll', requestUpdate, { passive: true });
  window.addEventListener('resize', requestUpdate, { passive: true });
  mobileLayout.addEventListener('change', requestUpdate);
  reduceMotion.addEventListener('change', requestUpdate);
  updateReveal();
</script>
