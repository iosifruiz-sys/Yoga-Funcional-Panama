---
const bookingUrl = 'https://wa.me/50762331434?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20las%20clases%20de%20Yoga%20Funcional.';
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-kicker" aria-hidden="true">ENTRENAMIENTO / ATENCIÓN / RECUPERACIÓN</div>
  <h1 id="hero-title" class="hero-title">
    <span class="yoga">Yoga</span>
    <span class="funcional">Funcional</span>
    <span class="panama">Panamá</span>
  </h1>

  <figure class="hero-photo">
    <picture>
      <source media="(min-width: 62rem)" srcset={`${base}images/hero-transparent.png`} />
      <img
        src={`${base}images/hero-transparent.png`}
        alt="Persona practicando yoga funcional sobre una esterilla rosa"
        width="1194"
        height="1317"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
  </figure>

  <blockquote>
    <span>No entrenamos a la persona para hacer yoga.</span>
    <strong>Usamos el yoga para entrenar a la persona.</strong>
  </blockquote>

  <a id="reservar" class="reserve" href={bookingUrl} target="_blank" rel="noopener noreferrer">
    <span>Reservar</span><span class="reserve-arrow" aria-hidden="true">↗</span>
  </a>
  <p class="hero-meta"><span>PTY</span> <span>08°58'N</span> <span>CLASES / PRÓXIMAMENTE</span></p>
</section>
