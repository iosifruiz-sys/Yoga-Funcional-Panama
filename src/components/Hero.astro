---
import { localizedPath, type Locale } from '../i18n';
import heroEs from '../data/hero/es.json';
import heroRu from '../data/hero/ru.json';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const hero = { es: heroEs, ru: heroRu }[locale];
const bookingUrl = 'https://wa.me/50762331434?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20las%20clases%20de%20Yoga%20Funcional.';
const base = import.meta.env.BASE_URL;
---

<section class="hero" aria-labelledby="hero-title">
  <h1 id="hero-title" class="hero-title">
    <span class="yoga">{hero.title.yoga}</span>
    <span class="funcional">{hero.title.funcional}</span>
    <span class="panama">{hero.title.panama}</span>
  </h1>

  <figure class="hero-photo">
    <picture>
      <source media="(min-width: 62rem)" srcset={`${base}images/hero-transparent.png`} />
      <img
        src={`${base}images/hero-transparent.png`}
        alt={hero.alt}
        width="1194"
        height="1317"
        loading="eager"
        fetchpriority="high"
      />
    </picture>
  </figure>

  <blockquote class:list={[locale === 'es' && 'hero-quote-es', locale === 'ru' && 'hero-quote-ru']}>
    <span>{hero.quote}</span>
    <strong>{hero.strong}</strong>
  </blockquote>

  {locale === 'es' && (
    <div class="hero-offer">
      <h2>{heroEs.offerTitle}</h2>
      <p>{heroEs.offerDescription}</p>
      <p>{heroEs.offerClosing}</p>
    </div>
  )}

  {locale === 'ru' && (
    <div class="hero-offer">
      <h2>{heroRu.offerTitle}</h2>
      <p>{heroRu.offerDescription}</p>
      <p>{heroRu.offerClosing}</p>
    </div>
  )}

  <a id="reservar" class="reserve" href={bookingUrl} target="_blank" rel="noopener noreferrer">
    <span>{hero.reserve}</span><span class="reserve-arrow" aria-hidden="true">↗</span>
  </a>
  <p class="hero-meta"><span>{hero.location}</span> <span>{hero.coordinates}</span> <span><a href={`${localizedPath(locale)}#clases`}>{hero.soon} <span aria-hidden="true">↗</span></a></span></p>
</section>

<style>
  .hero-meta a { text-decoration: none; }
  .hero-offer { display: none; }
  @media (min-width: 62rem) {
    .hero-quote-es { display: none; }
    :global(html[lang='ru']) .hero-quote-ru { display: none; }
    .hero-offer { display: block; grid-column: 1; grid-row: 3; align-self: end; padding: clamp(1rem, 4vw, 3.5rem) calc(var(--gutter) + .5rem) clamp(3.5rem, 4.63542vw, 5.5625rem); }
    .hero-offer h2 { margin: 0 0 clamp(1.5rem, 2.1875vw, 2.625rem); font: 400 clamp(1.56rem, 2.5vw, 3rem)/1.2 var(--font-utility); letter-spacing: -.03em; }
    :global(html[lang='ru']) .hero-offer h2 { font-size: 1.05vw; }
    .hero-offer p { margin: 0; max-width: 40.5rem; font: 400 clamp(.9rem, 1.04167vw, 1.25rem)/1.2 var(--font-body); letter-spacing: -.03em; }
    .hero-offer h2 + p { font-size: clamp(1.008rem, 1.16667vw, 1.4rem); line-height: 1.3; }
    .hero-offer p + p { margin-top: 1rem; font-weight: 500; }
  }
</style>
