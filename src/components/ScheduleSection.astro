---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const desktopTitle = 'desktopTitle' in t.schedule ? t.schedule.desktopTitle : undefined;
const schedule = [
  { day: t.schedule.days[0], time: '6:15 PM' },
  { day: t.schedule.days[1], time: '6:15 PM' },
  { day: t.schedule.days[2], time: '10:00 AM' },
];
const studioBookingUrl = 'https://wa.me/50765434870?text=Hola%2C%20quiero%20saber%20m%C3%A1s%20sobre%20las%20clases%20de%20Yoga%20Funcional.';
---

<section id="horarios" class="schedule" aria-labelledby="schedule-title">
  <header class="schedule-intro">
    <p class="schedule-number">{t.schedule.number}</p>
    <h2 id="schedule-title">
      <span class:list={{ 'schedule-title-mobile': desktopTitle }}>{t.schedule.title[0]}</span><span class:list={['schedule-title-line-last', { 'schedule-title-mobile': desktopTitle }]}>{t.schedule.title[1]}</span>
      {desktopTitle && <><span class="schedule-title-desktop">{desktopTitle[0]}</span><span class="schedule-title-desktop schedule-title-line-last">{desktopTitle[1]}</span></>}
    </h2>
  </header>

  <div class="schedule-meta" aria-label={t.schedule.info}>
    <strong>Yoga Funcional</strong>
    <span>{t.schedule.kind}</span>
    <span>Clayton</span>
  </div>

  <ol class="schedule-list" aria-label={t.schedule.label}>
    {schedule.map((slot) => (
      <li class="schedule-slot">
        <span class="schedule-day">{slot.day}</span>
        <time class="schedule-time">{slot.time}</time>
      </li>
    ))}
  </ol>

  <footer class="schedule-booking">
    <a href={studioBookingUrl} target="_blank" rel="noopener noreferrer">
      {t.reserve} <span aria-hidden="true">→</span>
    </a>
  </footer>
</section>
