---
import type { Locale } from '../i18n';
import scheduleEs from '../data/schedule/es.json';
import scheduleRu from '../data/schedule/ru.json';
import scheduleData from '../data/schedule/classes.json';
import { sortGroupClasses, formatScheduleTime, validateScheduleBookingUrl, type GroupSchedule } from '../lib/schedule';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = { es: scheduleEs, ru: scheduleRu }[locale];
const desktopTitle = 'desktopTitle' in t ? [t.desktopTitle.first, t.desktopTitle.second] : undefined;
const sharedSchedule: GroupSchedule = scheduleData;
const schedule = sortGroupClasses(sharedSchedule.classes).map((slot) => ({
  day: t.days[slot.day],
  time: formatScheduleTime(slot.startTime),
}));
const studioBookingUrl = validateScheduleBookingUrl(sharedSchedule.bookingUrl);
---

<section id="horarios" class="schedule" aria-labelledby="schedule-title">
  <header class="schedule-intro">
    <p class="schedule-number">{t.number}</p>
    <h2 id="schedule-title">
      <span class:list={{ 'schedule-title-mobile': desktopTitle }}>{t.title.first}</span><span class:list={['schedule-title-line-last', { 'schedule-title-mobile': desktopTitle }]}>{t.title.second}</span>
      {desktopTitle && <><span class="schedule-title-desktop">{desktopTitle[0]}</span><span class="schedule-title-desktop schedule-title-line-last">{desktopTitle[1]}</span></>}
    </h2>
  </header>

  <div class="schedule-meta" aria-label={t.info}>
    <strong>{t.program}</strong>
    <span>{t.kind}</span>
    <span>{t.location}</span>
  </div>

  <ol class="schedule-list" aria-label={t.label}>
    {schedule.map((slot) => (
      <li class="schedule-slot">
        <span class="schedule-day">{slot.day}</span>
        <time class="schedule-time">{slot.time}</time>
      </li>
    ))}
  </ol>

  <footer class="schedule-booking">
    <a href={studioBookingUrl} target="_blank" rel="noopener noreferrer">
      {t.reserve} <span aria-hidden="true">→</span>
    </a>
  </footer>
</section>
