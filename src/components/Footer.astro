---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const basePath = import.meta.env.BASE_URL;
const footerLinks = {
  about: `${basePath}${locale === 'ru' ? 'ru/' : ''}#sobre-mi`,
  top: `${basePath}${locale === 'ru' ? 'ru/' : ''}#contenido`,
} as const;
---

<footer class="site-footer">
  <ul class="footer-socials" aria-label={t.socials}>
    <li><a href="https://www.instagram.com/iosif.ruiz/" target="_blank" rel="noopener noreferrer">Instagram</a></li>
    <li><a href="https://www.youtube.com/@thatsameiosif" target="_blank" rel="noopener noreferrer">YouTube</a></li>
    <li><a href="https://www.patreon.com/thatsameiosif" target="_blank" rel="noopener noreferrer">Patreon</a></li>
    <li><a href="https://www.tiktok.com/@iosifruiz" target="_blank" rel="noopener noreferrer">TikTok</a></li>
  </ul>

  <div class="footer-meta">
    <small><a href={footerLinks.about}>© 2026 IOSIF RUIZ</a></small>
    <small><a href={footerLinks.top}>YOGA FUNCIONAL · PANAMÁ</a></small>
  </div>
</footer>
