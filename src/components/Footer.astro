---
import { ui, type Locale } from '../i18n';
interface Props { locale?: Locale }
const { locale = 'es' } = Astro.props;
const t = ui[locale];
const basePath = import.meta.env.BASE_URL;
const footerLinks = {
  about: `${basePath}${locale === 'ru' ? 'ru/' : ''}#sobre-mi`,
  top: `${basePath}${locale === 'ru' ? 'ru/' : ''}#contenido`,
} as const;
---

<footer class="site-footer">
  <ul class="footer-socials" aria-label={t.socials}>
    <li><span>Instagram</span></li>
    <li><span>YouTube</span></li>
    <li><span>Patreon</span></li>
    <li><span>TikTok</span></li>
  </ul>

  <div class="footer-meta">
    <small><a href={footerLinks.about}>© 2026 IOSIF RUIZ</a></small>
    <small><a href={footerLinks.top}>YOGA FUNCIONAL · PANAMÁ</a></small>
  </div>
</footer>
